# Agent deliverables written by tr_write_file / the export dir
_output/

# deepagents on-disk scratch (durable copies live in the DB:
# artifacts + transcript_messages tables). CLI deletes these on exit;
# the daemon TTL-sweeps them — never commit them.
large_tool_results/
conversation_history/

# LangGraph in-proc dev-server state (AsyncSubagentHost / langgraph_api).
# Regenerated on every run and rewritten continuously while the daemon is up,
# so committing it produces a ~660KB..5MB binary diff per commit that conflicts
# on every branch. It also carries real run history (thread/run ids, Human/AI
# message payloads, token usage) — never commit them.
.langgraph_api/
*.pckl

# Generated diagrams at the repo root. Anchored with a leading slash so that
# docs/diagrams/ — which holds hand-authored, committed diagrams — is not
# swept up by the same rule.
/diagrams/

# YouTube series production notes — drafted in-tree, published elsewhere.
content/

# Google Cloud credentials written by `gcloud auth`
.env.gcloud/
.gcloud/
