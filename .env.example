###############################################################################
# YUYUTSAVA — example environment configuration
#
# Copy to `.env` (auto-loaded by the CLI / daemon via load_dotenv) and fill in.
# Everything here is OPTIONAL except the API key for your chosen LLM provider.
# Values shown after `=` are the code defaults — uncomment only to override.
#
# ── Role-prefix override convention ──────────────────────────────────────────
# Most LLM/context vars support a `<ROLE>_<NAME>` override that wins over the
# bare `<NAME>` (see core/config.py::_env). Known roles:
#     triage · orchestrator · subagent · compaction · tier_light · cli · embed
# Example: run triage on a cheap local model while everything else uses Groq:
#     LLM_PROVIDER=groq
#     TRIAGE_LLM_PROVIDER=ollama
#     TRIAGE_OLLAMA_MODEL=llama3.2:3b
###############################################################################


# =============================================================================
# 1. LLM PROVIDER (required — pick ONE provider, set its key)
# =============================================================================
# Which provider the "main" agent uses: groq | openrouter | anthropic | ollama
LLM_PROVIDER=groq

# --- Groq ------------------------------------------------------------------
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter ------------------------------------------------------------
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_HTTP_REFERER=          # optional, sent as HTTP-Referer header
# OPENROUTER_APP_TITLE=             # optional, sent as X-OpenRouter-Title

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Ollama (local, no API key) --------------------------------------------
# OLLAMA_HOST=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2:3b


# =============================================================================
# 2. MODEL ROUTING & TOKEN BUDGETS (Phase 4 — complexity-based routing)
# =============================================================================
# Route tasks to a lighter model below a complexity threshold. OFF by default.
# YUYUTSAVA_MODEL_ROUTING=0
# Comma-separated complexity cut points for the routing tiers.
# YUYUTSAVA_ROUTING_THRESHOLDS=
# The "light" tier resolves tier_light-prefixed provider vars, e.g.:
# TIER_LIGHT_LLM_PROVIDER=ollama
# TIER_LIGHT_OLLAMA_MODEL=llama3.2:3b

# Soft token budgets (used for accounting / guardrails).
# YUYUTSAVA_ORCHESTRATOR_TOKEN_BUDGET=
# YUYUTSAVA_SUBAGENT_TOKEN_BUDGET=


# =============================================================================
# 3. STORAGE BACKEND (SQLite default / Postgres for durable + pgvector mode)
# =============================================================================
# sqlite (zero-config) | postgres (requires `docker compose up -d`)
YUYUTSAVA_STORAGE_BACKEND=sqlite
# YUYUTSAVA_PG_DSN=postgresql://yuyutsava:yuyutsava@127.0.0.1:5433/yuyutsava
# YUYUTSAVA_PG_POOL_MIN=1
# YUYUTSAVA_PG_POOL_MAX=10
# Refuse to boot (instead of falling back to SQLite) if Postgres is down.
# YUYUTSAVA_STORAGE_REQUIRE=0


# =============================================================================
# 4. CONTEXT MANAGEMENT (compaction + tool-result offloading)
#    Supports role prefixes, e.g. ORCHESTRATOR_YUYUTSAVA_CONTEXT_COMPACT_FRACTION
# =============================================================================
# Input-context budget the compactor steers under (per-provider default if unset).
# YUYUTSAVA_CONTEXT_MAX_INPUT_TOKENS=128000
# Compact when est. tokens exceed this fraction of the budget.
# YUYUTSAVA_CONTEXT_COMPACT_FRACTION=0.7
# Recent messages kept verbatim after a compaction.
# YUYUTSAVA_CONTEXT_KEEP_MESSAGES=20
# Tool results larger than this (chars) are offloaded to the artifact store.
# YUYUTSAVA_CONTEXT_OFFLOAD_THRESHOLD_CHARS=20000
# Leading Human/System messages never summarized away (the task).
# YUYUTSAVA_CONTEXT_PIN_FIRST_MESSAGES=2
# Token cap on the summarizer's own input.
# YUYUTSAVA_CONTEXT_SUMMARIZER_INPUT_TOKENS=12000


# =============================================================================
# 5. SEMANTIC MEMORY & EMBEDDINGS (pgvector; default-on when Postgres is live)
# =============================================================================
# 1/true/yes to force-enable, 0 to force-disable. Defaults on with Postgres.
# YUYUTSAVA_MEMORY_ENABLED=
# YUYUTSAVA_MEMORY_TOP_K=5
# YUYUTSAVA_EMBED_MODEL=nomic-embed-text   # MUST output 768-dim (vector(768))
# Embedder endpoint (OpenAI-compatible /embeddings). Defaults to local Ollama.
# EMBED_LLM_PROVIDER=ollama
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama


# =============================================================================
# 6. WEB SEARCH TOOLS (ws_* tools)
# =============================================================================
# TAVILY_API_KEY=
# EXA_API_KEY=


# =============================================================================
# 7. DAEMON / WEB SERVER (FastAPI, loopback only)
# =============================================================================
# YUYUTSAVA_DAEMON_HOST=127.0.0.1
# YUYUTSAVA_DAEMON_PORT=7654
# YUYUTSAVA_DAEMON_URL=                 # client-side: where to reach the daemon
# YUYUTSAVA_DAEMON_OPEN_BROWSER=        # 1 to auto-open the UI on start
# Extra allowed CORS origins (loopback is always allowed).
# YUYUTSAVA_CORS_ORIGINS=
# Optional bearer token for API access (network-level security is primary).
# YUYUTSAVA_API_TOKEN=
# Expose the read-only DB inspection API (default on).
# YUYUTSAVA_DB_API_ENABLED=true


# =============================================================================
# 8. CONSENT / PROPOSALS / LIVENESS
# =============================================================================
# Seconds before an unanswered Tier-1 proposal expires.
# YUYUTSAVA_PROPOSAL_EXPIRY_SEC=
# SSE heartbeat interval.
# YUYUTSAVA_HEARTBEAT_SEC=


# =============================================================================
# 9. EXECUTION MODE & DOCKER SANDBOX
# =============================================================================
# Where tools run: local (host) | docker (isolated container)
YUYUTSAVA_EXECUTION=local
# YUYUTSAVA_DOCKER_IMAGE=deepagent-sandbox:local
# YUYUTSAVA_DOCKER_NETWORK=bridge       # bridge | none
# YUYUTSAVA_DOCKER_MEMORY=512m
# YUYUTSAVA_DOCKER_CPUS=1.0
# YUYUTSAVA_DOCKER_PIDS_LIMIT=100
# YUYUTSAVA_DOCKER_EXPORT_DIR=          # host dir mounted as /output


# =============================================================================
# 10. RESOURCE-AWARE EXECUTION (Phase 5 — admission control / deferral)
# =============================================================================
# YUYUTSAVA_RES_CPU_HIGH_PCT=85.0
# YUYUTSAVA_RES_MEM_MIN_MB=1024
# YUYUTSAVA_RES_DISK_MIN_GB=5.0
# YUYUTSAVA_RES_SAMPLE_SEC=5.0
# YUYUTSAVA_RES_DEFER_MAX_SEC=600.0
# YUYUTSAVA_RES_EMIT_SEC=10.0
# YUYUTSAVA_RES_HEAVY_COMPLEXITY=4
# YUYUTSAVA_RES_HEAVY_HINTS=            # comma-separated keywords flagged "heavy"
# YUYUTSAVA_RES_DOCKER_STATS=0          # 1 to sample docker stats (forks docker)


# =============================================================================
# 11. STORAGE PATHS & SQLITE DB FILES (override only for custom layouts)
# =============================================================================
# YUYUTSAVA_HOME=                       # root for all state (default ~/.yuyutsava)
# YUYUTSAVA_STATE_DB=                   # events store: proposals/decisions/rules/prefs
# YUYUTSAVA_CHECKPOINTS_DB=             # LangGraph checkpoints (sqlite mode)
# YUYUTSAVA_SESSIONS_DB=
# YUYUTSAVA_SESSIONS_BACKEND=sqlite
# YUYUTSAVA_INTERRUPTS_DB=
# YUYUTSAVA_BLOBS_DIR=                  # webcam frames etc. (auto-swept)
# YUYUTSAVA_OUTPUT_DIR=
# YUYUTSAVA_SANDBOX_DIR=
# YUYUTSAVA_CHANNELS_CONFIG=            # path to channels config file


# =============================================================================
# 12. VOICE I/O (speech-to-text / text-to-speech / wake word)
# =============================================================================
# --- Speech-to-text: faster_whisper (local) | groq (cloud) ------------------
# STT_PROVIDER=faster_whisper
# FASTER_WHISPER_MODEL=base
# GROQ_WHISPER_MODEL=whisper-large-v3   # used when STT_PROVIDER=groq (uses GROQ_API_KEY)

# --- Text-to-speech: piper (local) | elevenlabs (cloud) ---------------------
# TTS_PROVIDER=piper
# PIPER_MODEL=
# PIPER_MODEL_CONFIG=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Wake word: openwakeword ------------------------------------------------
# WAKE_PROVIDER=openwakeword
# WAKE_WORDS=hey_jarvis                 # comma-separated
# WAKE_THRESHOLD=0.5


# =============================================================================
# 13. NOTIFICATION CHANNELS (Telegram)
# =============================================================================
# YUYUTSAVA_TELEGRAM_BOT_TOKEN=
# YUYUTSAVA_TELEGRAM_CHAT_IDS=          # comma-separated chat ids


# =============================================================================
# 14. CLI / REPL UX
# =============================================================================
# YUYUTSAVA_CLI_LABEL=yuyutsava-cli
# YUYUTSAVA_REPL_SMOOTH=1               # smooth (typewriter) streaming
# YUYUTSAVA_REPL_SMOOTH_CPS=180         # chars/sec when smoothing
# YUYUTSAVA_REPL_RING=50                # REPL scrollback ring size
# YUYUTSAVA_REPL_RING_ENTRY_KB=100      # per-entry cap (KB)


# =============================================================================
# 15. OBSERVABILITY (Langfuse tracing — all three keys required to enable)
# =============================================================================
# Langfuse is OPTIONAL. Start its stack with:  docker compose --profile langfuse up -d
# (the shared Postgres above always runs; Langfuse adds ClickHouse/Redis/MinIO).
# Cost is NOT sourced from Langfuse — the llm_usage ledger is the system of
# record and works with Langfuse off; Langfuse mirrors the same numbers and is
# joined to the ledger by thread_id (== Langfuse session_id).
#
# Kill-switch: set LANGFUSE_ENABLED=0 to force tracing off even with keys set.
# Unset = active iff all three keys below are present.
# LANGFUSE_ENABLED=1
# LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_ME
# LANGFUSE_SECRET_KEY=sk-lf-REPLACE_ME
# LANGFUSE_HOST=http://localhost:3000


# =============================================================================
# 16. ADVANCED / DEBUG
# =============================================================================
# YUYUTSAVA_ASYNC_SUBAGENTS=0           # in-process async subagent host
# YUYUTSAVA_DEBUG_PLUMBING=0            # verbose channel/plumbing logs
# YUYUTSAVA_ALLOW_BLOCKING=0            # opt into STRICT blocking-I/O detection
#                                       # (LangGraph blockbuster). Default is permissive
#                                       # (warn-only): strict is not yet viable as a
#                                       # default (sync sqlite events store + task_runner
#                                       # path canonicalization run on the loop). Use =0
#                                       # in dev to hunt remaining on-loop blocking calls.
